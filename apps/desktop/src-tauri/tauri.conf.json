{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "OpenVI",
  "version": "0.19.0",
  "identifier": "io.github.theobiet.openvi",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev:web",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenVI",
        "width": 1200,
        "height": 780,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost blob: data:; media-src 'self' blob:; worker-src 'self' blob:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCACHE/work/models/**",
          "$APPCACHE/work/vehicles/**",
          "$APPCACHE/work/characters/**",
          "$APPCACHE/work/weapons/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Open-source data-mining toolkit for GTA VI files",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEREQ0FFMEM5RTZEQUVFNEIKUldSTDd0cm15ZURLM1FCZnhuUE9jaWM2UStFaER6ME1KRWZ2Wk15RC9yRndlY0RIWmYxMVlYaDYK",
      "endpoints": ["https://github.com/TheoBIET/OpenVI/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
